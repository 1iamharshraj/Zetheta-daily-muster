# Neon connection string (use the *pooled* URL on Vercel)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Emails that become HR (and active) the moment they create their account. Comma-separated.
HR_EMAILS=founder@zetheta.com,hr@zetheta.com

# Long random string. Vercel Cron sends it as a Bearer token to /api/cron/reminders
CRON_SECRET=change-me

# Public URL of the app (used in reminder emails / push links)
APP_URL=https://your-app.vercel.app

# Email reminders (any SMTP: Google Workspace app password, Resend SMTP, etc.)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zetheta Muster <muster@zetheta.com>"

# Browser push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hr@zetheta.com
